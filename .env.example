# Copie para .env.local para rodar no seu computador. Nunca coloque senhas reais neste arquivo.
# No servidor, estas configurações vêm dos Secrets do GitHub (docs/publicar.md).

# WhatsApp da loja com país e DDD, só dígitos (ex.: 55 + DDD + 980631673).
# Vazio: o botão abre o WhatsApp para a cliente escolher o contato.
NEXT_PUBLIC_WHATSAPP_NUMERO=

# MySQL. Sem MYSQL_DATABASE, o app usa os dados de exemplo e o painel fica em modo demonstração.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Painel: cada pessoa entra com o próprio e-mail e a própria senha (Acessos).
# E-mails da Administração fixa (qualquer e-mail), separados por vírgula. Não dá para
# remover nem mudar o papel deles em Acessos.
ADMIN_EMAILS=
# Chave de emergência, só para os e-mails de ADMIN_EMAILS: entra com ela quando
# esquecer a senha e cria uma senha nova na hora (as outras sessões caem).
PAINEL_SENHA=
# Texto aleatório longo que assina a sessão do painel. Sem ele, o painel fica em manutenção.
SESSAO_SEGREDO=
# Endereço público do site (ex.: https://monebrigaderia.com.br ou http://localhost:3000).
# Vai no convite com a senha provisória.
SITE_URL=http://localhost:3000

# Pasta onde ficam as fotos enviadas pelo painel (padrão: ./uploads).
UPLOAD_DIR=
