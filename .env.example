# Copie para .env.local e preencha. Nunca coloque segredos neste arquivo.

# WhatsApp da loja com país e DDD, só dígitos (ex.: 55 + DDD + 980631673).
# Vazio: o botão abre o WhatsApp para a cliente escolher o contato.
NEXT_PUBLIC_WHATSAPP_NUMERO=

# Supabase, quando o banco for ligado (Project Settings › API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
